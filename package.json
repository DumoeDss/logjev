    "start": "node dist/cli.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": { "yaml": "^2.9.1" },
  "devDependencies": { "@types/node": "^22.20.4", "typescript": "^7.0.2" }
